digraph Кинопрокат_Расширенная_Фреймовая_Модель {
    // Настройки графа
    rankdir=TB;
    node [shape=box, style="filled", fillcolor="#ECECEC", fontname="Arial", margin=0.1];

    // ==========================================================
    // Прототипы (Общие Структуры - Серые)
    // ==========================================================
    "Сущность" [fillcolor="#D3D3D3"];
    "Продукт_услуга" [fillcolor="#D3D3D3"];
    "Объект_Кинотеатра" [fillcolor="#D3D3D3"];
    "Участник_Процесса" [fillcolor="#D3D3D3"];
    "Транзакция" [fillcolor="#D3D3D3"];
    "Событие" [fillcolor="#D3D3D3"];
    
    // ==========================================================
    // Фреймы-структуры (Синие)
    // ==========================================================
    "Фильм" [fillcolor="#ADD8E6"];
    "Товар_Бара" [fillcolor="#ADD8E6"];
    "Билет" [fillcolor="#ADD8E6"];
    "Сеанс" [fillcolor="#ADD8E6"];
    "Зал" [fillcolor="#ADD8E6"];
    "Место" [fillcolor="#ADD8E6"];
    "Скидка_Акция" [fillcolor="#ADD8E6"];
    "Клиент" [fillcolor="#ADD8E6"];
    "Сотрудник" [fillcolor="#ADD8E6"];
    "Покупка" [fillcolor="#ADD8E6"];
    "Возврат" [fillcolor="#ADD8E6"];
    "Запрос_Клиента" [fillcolor="#ADD8E6"];
    
    // ==========================================================
    // Фреймы-роли и образцы (Зеленые)
    // ==========================================================
    "Кассир" [fillcolor="#90EE90"];
    "Администратор" [fillcolor="#90EE90"];
    "Клиент_VIP" [fillcolor="#90EE90"];
    "Фильм_Премьера" [fillcolor="#90EE90"];
    "Зал_№5_IMAX" [fillcolor="#90EE90"];
    "Место_D12" [fillcolor="#90EE90"];
    
    // ==========================================================
    // Фреймы-сценарии и ситуации (Желтые)
    // ==========================================================
    "Покупка_Билета" [fillcolor="#FFFACD"];
    "Возврат_Билета" [fillcolor="#FFFACD"];
    "Обращение_в_Поддержку" [fillcolor="#FFFACD"];
    "Сеанс_Дня" [fillcolor="#FFFACD"];
    
    // ==========================================================
    // 1. Связи Наследования (АКО - A Kind Of)
    // ==========================================================
    "Фильм" -> "Продукт_услуга" [label="АКО"];
    "Товар_Бара" -> "Продукт_услуга" [label="АКО"];
    "Билет" -> "Продукт_услуга" [label="АКО"];
    "Сеанс" -> "Событие" [label="АКО"];

    "Зал" -> "Объект_Кинотеатра" [label="АКО"];
    "Место" -> "Объект_Кинотеатра" [label="АКО"];

    "Клиент" -> "Участник_Процесса" [label="АКО"];
    "Сотрудник" -> "Участник_Процесса" [label="АКО"];

    "Кассир" -> "Сотрудник" [label="АКО"];
    "Администратор" -> "Сотрудник" [label="АКО"];
    "Клиент_VIP" -> "Клиент" [label="АКО"];

    "Покупка" -> "Транзакция" [label="АКО"];
    "Возврат" -> "Транзакция" [label="АКО"];

    "Фильм_Премьера" -> "Фильм" [label="АКО"];
    "Зал_№5_IMAX" -> "Зал" [label="АКО"];
    "Место_D12" -> "Место" [label="АКО"];
    "Сеанс_Дня" -> "Сеанс" [label="АКО"];
    
    // ==========================================================
    // 2. Связи Слотов (Отношения)
    // ==========================================================
    
    // Связи Ассортимента
    "Фильм" -> "Скидка_Акция" [label="Слот: Применяемая_скидка", color=blue];
    "Сеанс" -> "Зал" [label="Слот: Проходит_в", color=blue];
    "Зал" -> "Место" [label="Слот: Содержит_место", color=blue];
    
    // Связи Процесса Покупки
    "Покупка_Билета" -> "Клиент" [label="Слот: Инициатор", color=red];
    "Покупка_Билета" -> "Кассир" [label="Слот: Обслуживает", color=red];
    "Покупка_Билета" -> "Билет" [label="Слот: Результат", color=red];
    "Покупка_Билета" -> "Сеанс_Дня" [label="Слот: Выбранный_сеанс", color=red];
    
    // Связи Объектов в Покупке
    "Билет" -> "Фильм" [label="Слот: На_фильм", color=purple];
    "Билет" -> "Место" [label="Слот: Забронировано", color=purple];
    
    // Связи Лояльности и Обращений
    "Клиент_VIP" -> "Скидка_Акция" [label="Слот: Имеет_льготу", color=orange];
    "Возврат_Билета" -> "Билет" [label="Слот: Возвращаемый_объект", color=green];
    "Возврат_Билета" -> "Администратор" [label="Слот: Оформляет", color=green];
    "Обращение_в_Поддержку" -> "Администратор" [label="Слот: Обработал", color=gray, style=dotted];
    "Обращение_в_Поддержку" -> "Запрос_Клиента" [label="Слот: Содержит_запрос", color=gray, style=dotted];
}